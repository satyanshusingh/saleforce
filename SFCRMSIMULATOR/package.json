{
  "name": "salesforce-crm-enterprise-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Account-free React + local Node CRM classroom simulator",
  "scripts": {
    "server": "node server/server.mjs",
    "dev": "vite --host 127.0.0.1",
